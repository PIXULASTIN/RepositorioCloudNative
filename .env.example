
DB_HOST=<endpoint-de-RDS>
DB_USER=<usuario-rds>
DB_PASSWORD=<password-rds>
CORS_ORIGINS=http://localhost:4200

RABBITMQ_USER=<usuario-rabbit>
RABBITMQ_PASSWORD=<password-rabbit>
RABBITMQ_ERLANG_COOKIE=<cadena-aleatoria-larga>

# EP5: Kafka (opcional en la EC2; por defecto los servicios funcionan sin Kafka)
# KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29093,kafka3:29094
# KAFKA_CREATE_TOPICS=false
# KAFKA_CONSUMER_AUTO_STARTUP=false
